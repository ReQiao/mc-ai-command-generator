{
  "name": "mc-ai-command-generator",
  "version": "0.1.0",
  "description": "AI 驱动的 Minecraft 通用指令生成器（Electron exe + Fabric Mod）",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "ReQiao",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "test": "tsx src/shared/logic/builder.test.mjs && tsx src/shared/logic/p2.test.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "mod:build": "cd mod && ./gradlew build"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.22.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
