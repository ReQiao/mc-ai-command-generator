# 复制为 .env 并填入真实值（.env 已在 .gitignore，不会入库）

# 通义千问 / DashScope（OpenAI 兼容接口）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选：覆盖默认 endpoint / 模型
# DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# DASHSCOPE_MODEL=qwen-plus

# Mod HTTP 监听端口（默认 25580，需与 Mod 端配置一致）
# MOD_BRIDGE_PORT=25580
